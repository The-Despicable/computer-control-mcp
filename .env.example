# Input safety. false = observe-only server (mutations -> POLICY_DENIED).
COMPUTER_CONTROL_INPUT_ENABLED=false
# Optional comma-separated allowlist of owning-process PIDs (harness-owned windows only).
COMPUTER_CONTROL_ALLOWED_PIDS=
# Optional comma-separated title substrings (case-insensitive) for target windows.
COMPUTER_CONTROL_ALLOWED_WINDOW_TITLES=
# Observation freshness (ms). Mutations on older screen_ids -> STALE_SCREEN.
COMPUTER_CONTROL_MAX_OBSERVATION_AGE_MS=30000
COMPUTER_CONTROL_OBSERVATION_CACHE=32
COMPUTER_CONTROL_MAX_IMAGE_MB=12
# Windows PowerShell 5.1 (built-in). pwsh 7 is NOT supported (WinRT OCR unavailable).
COMPUTER_CONTROL_POWERSHELL=powershell.exe
# Persistent PowerShell worker: auto (pool with spawn fallback) | worker | spawn.
COMPUTER_CONTROL_PS_MODE=auto
# Two lanes: control = window discovery/info/focus/state/input (never starved by
# perception); perception = capture/UIA/OCR. Legacy COMPUTER_CONTROL_PS_POOL sets
# the perception lane size.
COMPUTER_CONTROL_PS_CONTROL_POOL=1
COMPUTER_CONTROL_PS_PERCEPTION_POOL=2
# Fail startup on Windows if the backend is not ready (default: warn only).
COMPUTER_CONTROL_REQUIRE_WINDOWS=false
# Opt-in structured performance instrumentation on stderr ([computer-control][timing]).
# Also enabled by COMPUTER_CONTROL_LOG=debug.
COMPUTER_CONTROL_TIMING=0
COMPUTER_CONTROL_LOG=info
